<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DesktopTools</RootNamespace>
    <AssemblyName>DesktopTools</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopTools.Tests" />
    <!-- 保证 F5 / dotnet run / 整包编译都先产出 Helper，再复制到固定 helper\ 布局 -->
    <ProjectReference Include="..\DesktopTools.Helper\DesktopTools.Helper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyHelper" AfterTargets="Build">
    <ItemGroup>
      <HelperFiles Include="$(MSBuildThisFileDirectory)..\DesktopTools.Helper\bin\$(Configuration)\net10.0-windows\DesktopTools.Helper.exe" />
      <HelperFiles Include="$(MSBuildThisFileDirectory)..\DesktopTools.Helper\bin\$(Configuration)\net10.0-windows\DesktopTools.Helper.dll" />
      <HelperFiles Include="$(MSBuildThisFileDirectory)..\DesktopTools.Helper\bin\$(Configuration)\net10.0-windows\DesktopTools.Helper.runtimeconfig.json" />
      <HelperFiles Include="$(MSBuildThisFileDirectory)..\DesktopTools.Helper\bin\$(Configuration)\net10.0-windows\DesktopTools.Helper.deps.json" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)helper" />
    <Copy SourceFiles="@(HelperFiles)" DestinationFolder="$(OutputPath)helper" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutputPath)helper\DesktopTools.Helper.exe')"
           Text="DesktopTools.Helper.exe missing under $(OutputPath)helper. Build order or Helper output is broken." />
  </Target>

</Project>
